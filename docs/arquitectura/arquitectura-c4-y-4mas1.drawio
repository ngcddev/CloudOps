4" value="&lt;b&gt;Cerrar la corrida: fallo&lt;/b&gt; · los pasos siguientes no corren (if: always())" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="230.0" y="1500" width="520" height="48" as="geometry"/></mxCell><mxCell id="e55" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;Versión bloqueada&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:9.5px;color:#4B5563&#x27;&gt;el Hub no deja aprobarla&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100.0" y="1496" width="260" height="56" as="geometry"/></mxCell><mxCell id="e57" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;strokeColor=#5B7AA5;fontColor=#1F3B5C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="fontFamily=Helvetica;shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1217" y="1584" width="26" height="26" as="geometry"/></mxCell><mxCell id="e59" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c56" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="fontFamily=Helvetica;ellipse;html=1;shape=doubleEllipse;fillColor=#1F2937;strokeColor=#1F2937;margin=4;" vertex="1" parent="1"><mxGeometry x="1215" y="1434" width="30" height="30" as="geometry"/></mxCell><mxCell id="e61" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c45" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="&lt;b&gt;Cómo se lee&lt;/b&gt;&lt;br&gt;Cada paso informa su resultado al Hub (pipelines/reportar.sh). El primer control que falla corta la corrida; el último paso la cierra siempre. Los secretos (token del Hub, registro y clave de Cosign) se definen en la organización de Gitea, no en el workflow." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="270" height="150" as="geometry"/></mxCell><mxCell id="c63" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1638" width="1340" height="2" as="geometry"/></mxCell><mxCell id="c64" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de pipelines/puerta.yaml y pipelines/puerta.sh (pasos inicio, secretos, construir, vulnerabilidades, sbom, firmar, verificar y fin) y backend/app/routers/pipeline.py. Verde: salida correcta; naranja: bloqueo; flecha punteada: aviso HTTP al Hub.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1644" width="1340" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>