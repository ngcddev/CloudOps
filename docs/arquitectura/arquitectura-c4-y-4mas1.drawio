2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="722" y="628" width="36" height="36" as="geometry"/></mxCell><mxCell id="e25" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;El cambio se puede fusionar&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="706" width="260" height="48" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;No se fusiona&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:9.5px&#x27;&gt;se corrige y se vuelve a subir&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="706" width="260" height="48" as="geometry"/></mxCell><mxCell id="e28" value="[los cinco pasan]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="646"/></Array></mxGeometry></mxCell><mxCell id="e29" value="[alguno falla]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="646"/></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="fontFamily=Helvetica;ellipse;html=1;shape=doubleEllipse;fillColor=#1F2937;strokeColor=#1F2937;margin=4;" vertex="1" parent="1"><mxGeometry x="535" y="788" width="30" height="30" as="geometry"/></mxCell><mxCell id="c31" value="" style="fontFamily=Helvetica;shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="917" y="790" width="26" height="26" as="geometry"/></mxCell><mxCell id="e32" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Diferencia con la puerta de Gitea&lt;/b&gt;: la CI revisa el código y la imagen del Hub, pero no firma ni publica, porque el registro del laboratorio no es alcanzable desde GitHub (ADR-03 y ADR-05). Firmar, publicar y verificar lo hace la puerta de cada sitio." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="120" y="850" width="1240" height="50" as="geometry"/></mxCell><mxCell id="c35" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="938" width="1400" height="2" as="geometry"/></mxCell><mxCell id="c36" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de .github/workflows/ci.yml (trabajos calidad, pruebas, operacion, analisis y seguridad; ninguno depende de otro). Barra negra: bifurcación y unión de trabajos paralelos; rombo: decisión.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="1400" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="Pipeline · puerta Gitea"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1690" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA · PUERTA DE SEGURIDAD&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Puerta de seguridad de cada versión (Gitea Actions)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;Diagrama de actividad UML · cada etiqueta v* que se sube al repositorio de un sitio dispara la puerta y el Hub registra la corrida&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1340" height="2" as="geometry"/></mxCell><mxCell id="c3" value="" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#9AA8BA;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="800" height="1480" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Ejecutor de Gitea Actions · pipelines/puerta.yaml&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#9AA8BA;fontSize=11.5;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="800" height="46" as="geometry"/></mxCell><mxCell id="c5" value="" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#9AA8BA;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="240" height="1480" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Registro de Gitea&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#9AA8BA;fontSize=11.5;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="240" height="46" as="geometry"/></mxCell><mxCell id="c7" value="" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#9AA8BA;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="300" height="1480" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;API del Hub&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#9AA8BA;fontSize=11.5;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="300" height="46" as="geometry"/></mxCell><mxCell id="c9" value="" style="fontFamily=Helvetica;ellipse;html=1;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="457" y="196" width="26" height="26" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Recibir la etiqueta v*&lt;/b&gt; y descargar esa versión del repositorio del sitio" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="190.0" y="244" width="560" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Abrir la corrida en el Hub&lt;/b&gt; con el commit y las imágenes" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="190.0" y="316" width="560" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Registrar la corrida&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:9.5px;color:#4B5563&#x27;&gt;POST /api/pipeline-events · token&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100.0" y="310" width="260" height="56" as="geometry"/></mxCell><mxCell id="e13" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;strokeColor=#5B7AA5;fontColor=#1F3B5C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;1 · Secretos&lt;/b&gt; &lt;span style=&quot;color:#1F3B5C&quot;&gt;· Gitleaks 8.30.1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9C3D0A&quot;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; hay un secreto en los commits nuevos de la versión&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190.0" y="400" width="560" height="64" as="geometry"/></mxCell><mxCell id="e17" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="452" y="486" width="36" height="36" as="geometry"/></mxCell><mxCell id="e19" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;2 · Pruebas y construcción&lt;/b&gt; &lt;span style=&quot;color:#1F3B5C&quot;&gt;· pytest del sitio y docker build&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9C3D0A&quot;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; las pruebas fallan o la imagen no construye&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190.0" y="556" width="560" height="64" as="geometry"/></mxCell><mxCell id="e21" value="[ok]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="452" y="642" width="36" height="36" as="geometry"/></mxCell><mxCell id="e23" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;3 · Vulnerabilidades&lt;/b&gt; &lt;span style=&quot;color:#1F3B5C&quot;&gt;· Trivy 0.76.1 (imagen, config y dependencias)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9C3D0A&quot;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; hay una CVE CRÍTICA con arreglo, configuración ALTA o CRÍTICA (root, privilegios) o una dependencia vulnerable&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190.0" y="712" width="560" height="78" as="geometry"/></mxCell><mxCell id="e25" value="[ok]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="452" y="812" width="36" height="36" as="geometry"/></mxCell><mxCell id="e27" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;4 · SBOM y licencias&lt;/b&gt; &lt;span style=&quot;color:#1F3B5C&quot;&gt;· Syft 1.55.0 · SPDX&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9C3D0A&quot;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; hay una licencia CRÍTICA en el inventario&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190.0" y="882" width="560" height="64" as="geometry"/></mxCell><mxCell id="e29" value="[ok]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="452" y="968" width="36" height="36" as="geometry"/></mxCell><mxCell id="e31" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;5 · Firma y procedencia&lt;/b&gt; &lt;span style=&quot;color:#1F3B5C&quot;&gt;· Skopeo sube por digest · Cosign 3.1.4&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9C3D0A&quot;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; no se puede subir, firmar o atestiguar (SLSA y SBOM)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="190.0" y="1038" width="560" height="64" as="geometry"/></mxCell><mxCell id="e33" value="[ok]" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="452" y="1124" width="36" height="36" as="geometry"/></mxCell><mxCell id="e35" value=