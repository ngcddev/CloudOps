t="1" source="c40" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c85" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1218" width="2560" height="2" as="geometry"/></mxCell><mxCell id="c86" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de los import de backend/app/routers/, services/ e integrations/ (17 de noviembre de 2026). Cada componente agrupa un router con las reglas de negocio que usa; solo las integraciones hablan con sistemas externos y el Hub no habla con Kubernetes. La compuerta servida por MLflow (opcional) se ve en el nivel 2.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1224" width="2560" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4+1 · Vista general"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="940" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA 4+1 · VISTA GENERAL&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Modelo de vistas 4+1 de la arquitectura&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;CloudOps Hub · Kruchten (1995) · Cuatro vistas complementarias unidas por los escenarios&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vista lógica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#D6E4F5&quot;&gt;Usuarios finales · funcionalidad&lt;/span&gt;" style="fontFamily=Helvetica;swimlane;html=1;whiteSpace=wrap;startSize=58;fillColor=#1F3B5C;fontColor=#FFFFFF;strokeColor=#1F3B5C;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;align=left;spacingLeft=14;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="600" height="230" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Modelo de dominio: 22 entidades en 6 paquetes (clientes y contratos, mesa de servicio, incidentes, puerta de seguridad, usuarios y auditoría, IA).&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Estados canónicos de solicitud, cambio, incidente, servicio y texto de IA.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Prioridad por impacto × urgencia y SLA P1–P4 por plan.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; &lt;b&gt;Diagrama:&lt;/b&gt; página «4+1 · Lógica» (diagrama de clases UML).&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=14;whiteSpace=wrap;fontSize=12.5;fontColor=#262626;" vertex="1" parent="c3"><mxGeometry x="0" y="58" width="600" height="172" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vista de desarrollo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#D6E4F5&quot;&gt;Programadores · organización del software&lt;/span&gt;" style="fontFamily=Helvetica;swimlane;html=1;whiteSpace=wrap;startSize=58;fillColor=#1F3B5C;fontColor=#FFFFFF;strokeColor=#1F3B5C;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;align=left;spacingLeft=14;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="600" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Monorepo: backend/, frontend/, voz/, ai/ y apps/ (sitios de los clientes).&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; API en capas: routers → services → integrations, sobre models/ y alembic/.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Plataforma como código: gitops/, infra/ (OpenTofu), observability/ y pipelines/.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; &lt;b&gt;Diagrama:&lt;/b&gt; página «4+1 · Desarrollo» (diagrama de paquetes UML).&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=14;whiteSpace=wrap;fontSize=12.5;fontColor=#262626;" vertex="1" parent="c5"><mxGeometry x="0" y="58" width="600" height="172" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vista de procesos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#D6E4F5&quot;&gt;Integradores · concurrencia, rendimiento y disponibilidad&lt;/span&gt;" style="fontFamily=Helvetica;swimlane;html=1;whiteSpace=wrap;startSize=58;fillColor=#1F3B5C;fontColor=#FFFFFF;strokeColor=#1F3B5C;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;align=left;spacingLeft=14;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="600" height="230" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Procesos concurrentes: sondeos de Blackbox (5 s), reglas de Prometheus, webhook de Alertmanager, vigilante de despliegues (15 s) y reconciliación de Argo CD.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Caso Empresa A: detección en ≤ 60 s, rollback por Git y cierre con MTTR.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; &lt;b&gt;Diagrama:&lt;/b&gt; página «4+1 · Procesos» (diagrama de secuencia UML).&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=14;whiteSpace=wrap;fontSize=12.5;fontColor=#262626;" vertex="1" parent="c7"><mxGeometry x="0" y="58" width="600" height="172" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vista física&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#D6E4F5&quot;&gt;Ingenieros de sistemas · topología y comunicación&lt;/span&gt;" style="fontFamily=Helvetica;swimlane;html=1;whiteSpace=wrap;startSize=58;fillColor=#1F3B5C;fontColor=#FFFFFF;strokeColor=#1F3B5C;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;align=left;spacingLeft=14;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="600" height="230" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Un equipo anfitrión con Docker Desktop: clúster k3d de un solo nodo (k3s v1.32.9).&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Namespaces de plataforma (hub, gitea, argocd, monitoring, mlops) y uno por cliente.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Ollama en el anfitrión con GPU; runner y estado de OpenTofu como contenedores aparte.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; &lt;b&gt;Diagrama:&lt;/b&gt; página «4+1 · Física» (diagrama de despliegue UML).&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=14;whiteSpace=wrap;fontSize=12.5;fontColor=#262626;" vertex="1" parent="c9"><mxGeometry x="0" y="58" width="600" height="172" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:15px&quot;&gt;Escenarios (+1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#D6E4F5&quot;&gt;Todas las partes interesadas · validación&lt;/span&gt;" style="fontFamily=Helvetica;swimlane;html=1;whiteSpace=wrap;startSize=58;fillColor=#1061B0;fontColor=#FFFFFF;strokeColor=#1061B0;swimlaneFillColor=#FFFFFF;collapsible=0;container=1;align=left;spacingLeft=14;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="760" y="380" width="280" height="240" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; 16 casos de uso (CU-01 a CU-16) de agencia, cliente y sistemas.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; Caso integrador: caída y recuperación del sitio de la Empresa A.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px&quot;&gt;▪&amp;nbsp; &lt;b&gt;Diagrama:&lt;/b&gt; página «4+1 · Escenarios».&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=14;whiteSpace=wrap;fontSize=12.5;fontColor=#262626;" vertex="1" parent="c11"><mxGeometry x="0" y="58" width="280" height="182" as="geometry"/></mxCell><mxCell id="e13" value="" style="fontFamily=Helvetica;endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#1061B0;strokeWidth=1.5;rounded=0;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="fontFamily=Helvetica;endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#1061B0;strokeWidth=1.5;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="fontFamily=Helvetica;endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#1061B0;strokeWidth=1.5;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="fontFamily=Helvetica;endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#1061B0;strokeWidth=1.5;rounded=0;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Las entidades se reparten&lt;br&gt;en módulos y capas" style="fontFamily=Helvetica;endArrow=open;startArrow=open;html=1;strokeColor=#8C8C8C;strokeWidth=1;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="Los procesos se asignan&lt;br&gt;a contenedores y nodos" style="fontFamily=Helvetica;endArrow=open;startArrow=open;html=1;strokeColor=#8C8C8C;strokeWidth=1;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;rounded=0;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="Los servicios del dominio&lt;br&gt;se ejecutan como procesos" style="fontFamily=Helvetica;endArrow=open;startArrow=open;html=1;strokeColor=#8C8C8C;strokeWidth=1;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="Cada módulo produce&lt;br&gt;una imagen desplegable" style="fontFamily=Helvetica;endArrow=open;startArrow=open;html=1;strokeColor=#8C8C8C;strokeWidth=1;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia con el modelo de Kruchten, P. (1995). Architectural Blueprints—The “4+1” View Model of Software Architecture. IEEE Software, 12(6), 42–50. Las vistas de contexto y contenedores del modelo C4 (Brown, s. f.) complementan la vista lógica y la física.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="1720" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="4+1 · Lógica"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="1460" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA 4+1 · VISTA LÓGICA&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Vista lógica: modelo de dominio&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;Diagrama de clases UML · entidades persistentes del Hub (backend/app/models/) agrupadas por paquete funcional&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="2140" height="2" as="geometry"/></mxCell><mxCell id="c3" value="Clientes y contratos" style="fontFamily=Helvetica;shape=folder;tabWidth=210;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F7F9FC;strokeColor=#8EA4BF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1310" height="380" as="geometry"/></mxCell><mxCell id="c4" value="Usuarios y auditoría" style="fontFamily=Helvetica;shape=folder;tabWidth=210;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F7F9FC;strokeColor=#8EA4BF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="1390" y="140" width="790" height="380" as="geometry"/></mxCell><mxCell id="c5" value="Mesa de servicio" style="fontFamily=Helvetica;shape=folder;tabWidth=210;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F7F9FC;strokeColor=#8EA4BF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="790" height="440" as="geometry"/></mxCell><mxCell id="c6" value="Operación de incidentes" style="fontFamily=Helvetica;shape=folder;tabWidth=210;tabHeight=26;tabPosition=right;html=1;whiteSpace=wrap;fillColor=#F7F9FC;strokeColor=#8EA4BF;align=right;spacingRight=12;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="850" y="570" width="520" height="440" as="geometry"/></mxCell><mxCell id="c7" value="Puerta de seguridad" style="fontFamily=Helvet