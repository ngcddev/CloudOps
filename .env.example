# Variables de entorno de desarrollo del Hub.
# Copiar a .env (ignorado por Git) antes de levantar el entorno:  cp .env.example .env
# Solo valores de desarrollo local; nunca poner aquí contraseñas reales (RNF-06).

# ---------- PostgreSQL (servicio db) ----------
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_dev
POSTGRES_DB=hub
# Puerto en tu máquina; cámbialo si ya usas el 5432
DB_PORT=5432

# ---------- API (servicio api) ----------
# Dentro de docker compose el host de la base es "db"
DATABASE_URL=postgresql+psycopg://hub:hub_dev@db:5432/hub
# Puerto de la API en tu máquina
API_PORT=8000

# ---------- Sesiones (spec 007) ----------
# Clave con la que la API firma los tokens de sesión. En k3s va en el Secret hub-auth.
# Este valor es público: la API se niega a arrancar con él (y con cualquier clave de menos de 32 caracteres).
# Después de copiar este archivo a .env, cámbialo por uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=clave-de-desarrollo-cambiala-en-produccion-0123456789
# Contraseña que el seed aplica a todos los usuarios sembrados (solo desarrollo local)
SEED_USER_PASSWORD=hub-desarrollo

# ---------- Puerta de seguridad (spec 006) ----------
# Token con el que el pipeline cuenta sus resultados al Hub (POST /api/pipeline-events). Solo desarrollo:
# en k3s va en el Secret hub-pipeline y en los secretos de Gitea Actions (HUB_PIPELINE_TOKEN).
PIPELINE_TOKEN=token-de-desarrollo-del-pipeline

# ---------- Frontend (servicio web) ----------
# Puerto de la consola en tu máquina
WEB_PORT=5173

# ---------- Sitios de los clientes (spec 002) ----------
# Versión de cada sitio (v1 = sana, v2 = rota a propósito: HTTP 500 en / y /health) y su puerto
RESTAURANTE_VERSION=v1
RESTAURANTE_PORT=8081
FERRETERIA_VERSION=v1
FERRETERIA_PORT=8082
CONSULTORIO_VERSION=v1
CONSULTORIO_PORT=8083

# ---------- GitOps (spec 005) ----------
# Gitea y Argo CD tal como los ve la API. Van comentadas a propósito: con ellas definidas la API arranca el
# seguimiento de Argo CD y, sin un clúster, falla cada 15 s. Descoméntalas solo si el compose debe hablar con
# un Gitea y un Argo CD reales. Los tokens de aquí son valores de ejemplo, no reales: los verdaderos los
# crea gitops/hub/crear-tokens.sh y viven solo en el Secret hub-gitops-tokens.
GITEA_REPO=forja-digital/hub-gitops
#GITEA_URL=http://gitea.hub.local
#GITEA_TOKEN=token-de-ejemplo-gitea
#ARGOCD_URL=http://argocd.hub.local
#ARGOCD_TOKEN=token-de-ejemplo-argocd

# ---------- Monitoreo e incidentes (spec 008) ----------
# Direcciones que abre el navegador desde el detalle del incidente (registros en Grafana y commit en Gitea).
GRAFANA_URL=http://grafana.hub.local
GITEA_PUBLIC_URL=http://gitea.hub.local
# Token con el que Alertmanager avisa al Hub de una caída. Valor de desarrollo, no real: en k3s va en el
# Secret hub-alertmanager (namespaces hub y monitoring), creado por gitops/hub/crear-secretos.sh.
ALERTMANAGER_TOKEN=token-de-desarrollo-de-alertmanager

# ---------- Asistente local (spec 012) ----------
# Ollama en el PC B. Vacío = el asistente responde que la IA no está disponible; la compuerta y el Hub siguen.
#OLLAMA_URL=http://192.168.1.50:11434
#OLLAMA_MODEL=qwen2.5:7b-instruct
#OLLAMA_KEEP_ALIVE=2m
# Contexto del LLM: completo (toda la ayuda) | recuperacion (palabras) | rag (embeddings). El RAG necesita el modelo
# de embeddings en Ollama (ollama pull nomic-embed-text); si no responde, cae solo a recuperacion.
#ASSISTANT_CONTEXT_MODE=completo
#OLLAMA_EMBED_MODEL=nomic-embed-text
#RAG_TOP_K=4
#RAG_MIN_SCORE=0.60
# Compuerta servida por MLflow (spec 016): endpoint de `mlflow models serve` (ai/servidor-mlflow/docker-compose.yml, servicio modelo-compuerta).
# Con el Hub en docker compose: GATE_MODEL_URL=http://host.docker.internal:5001 ; vacío = JSON local de backend/app/assets.
#GATE_MODEL_URL=
# Servidor MLflow del PC B (ai/servidor-mlflow): train.py y run_eval.py registran ahí sus corridas
#MLFLOW_TRACKING_URI=http://localhost:5000

# ---------- Dashboards y métricas (spec 010) ----------
# URL con la que la API consulta Prometheus (job sitios del Blackbox y el de Traefik) para los dashboards.
# En k3s la consulta interna es http://prometheus.monitoring.svc:9090; con ella vacía los KPIs de disponibilidad
# responden «sin datos» sin romper el panel.
#PROMETHEUS_URL=http://prometheus.monitoring.svc:9090
#LOKI_URL=http://loki.monitoring.svc:3100

# Voz del asistente (spec 021): el servicio se levanta con `docker compose --profile voz up -d --build voz`
#VOZ_URL=http://voz:8100
#VOZ_TOKEN=
#WHISPER=small
