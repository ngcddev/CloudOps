e="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1635" as="sourcePoint"/><mxPoint x="390" y="1635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e59" value="31: redacta el borrador (borrador_ia)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=10;strokeColor=#262626;fontSize=11;fontColor=#1F2937;labelBackgroundColor=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="1665" as="sourcePoint"/><mxPoint x="830" y="1665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e60" value="32: texto propuesto" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=10;strokeColor=#262626;fontSize=11;fontColor=#1F2937;labelBackgroundColor=none;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1695" as="sourcePoint"/><mxPoint x="390" y="1695" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e61" value="33: aprueba o corrige (aprobación humana)" style="fontFamily=Helvetica;html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#262626;fontSize=11;fontColor=#1F2937;labelBackgroundColor=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1715" as="sourcePoint"/><mxPoint x="390" y="1715" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="&lt;b&gt;Restricción de diseño.&lt;/b&gt; La API no habla con Kubernetes: el rollback es un commit en Git y Argo CD lo aplica. Los procesos 1–8 (telemetría), 18–19 (Argo CD) y 20–22 (vigilante) corren en paralelo y sin coordinación directa." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="1500" y="640" width="640" height="74" as="geometry"/></mxCell><mxCell id="c63" value="" style="fon