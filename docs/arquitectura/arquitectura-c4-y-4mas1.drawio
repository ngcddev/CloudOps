l=1;strokeColor=#8A9BB0;strokeWidth=1.1;endFill=0;startFill=0;endSize=12;startSize=12;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToMany;endArrow=ERzeroToOne;exitX=0;exitY=0.8408;exitDx=0;exitDy=0;entryX=0.0531;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c571" target="c219"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2100" y="1594.0"/><mxPoint x="2100" y="1750"/><mxPoint x="897" y="1750"/></Array></mxGeometry></mxCell><mxCell id="c687" value="&lt;b style=&quot;font-size:12px&quot;&gt;Convenciones&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9CED6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="320" height="330" as="geometry"/></mxCell><mxCell id="e688" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3B5C;strokeWidth=1.4;endFill=0;startFill=0;endSize=12;startSize=12;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToMany;endArrow=ERmandOne;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="56" y="317" as="sourcePoint"/><mxPoint x="130" y="317" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c689" value="Cero o muchos → exactamente uno (FK NOT NULL)" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="140" y="301" width="210" height="32" as="geometry"/></mxCell><mxCell id="e690" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3B5C;strokeWidth=1.4;endFill=0;startFill=0;endSize=12;startSize=12;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToMany;endArrow=ERzeroToOne;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="56" y="357" as="sourcePoint"/><mxPoint x="130" y="357" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c691" value="Cero o muchos → cero o uno (FK opcional)" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="140" y="341" width="210" height="32" as="geometry"/></mxCell><mxCell id="e692" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A9BB0;strokeWidth=1.1;endFill=0;startFill=0;endSize=12;startSize=12;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToMany;endArrow=ERzeroToOne;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="56" y="397" as="sourcePoint"/><mxPoint x="130" y="397" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c693" value="Referencia a users (autor, responsable, aprobador o actor)" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="140" y="381" width="210" height="32" as="geometry"/></mxCell><mxCell id="c694" value="&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; única&lt;br&gt;&lt;b&gt;negrita&lt;/b&gt; = NOT NULL (marcado &lt;b&gt;NN&lt;/b&gt;)&lt;br&gt;La línea sale de la fila de la FK y llega a la tabla referida (siempre su &lt;u&gt;id&lt;/u&gt;).&lt;br&gt;Todas las relaciones son no identificantes: cada tabla tiene clave sustituta &lt;i&gt;id&lt;/i&gt;." style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="56" y="429" width="296" height="110" as="geometry"/></mxCell><mxCell id="c695" value="&lt;b style=&quot;font-size:12px&quot;&gt;Dominios&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9CED6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="320" height="200" as="geometry"/></mxCell><mxCell id="c696" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#DCE6F2;strokeColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="56" y="674" width="40" height="16" as="geometry"/></mxCell><mxCell id="c697" value="Clientes y contratos" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="670" width="240" height="24" as="geometry"/></mxCell><mxCell id="c698" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#E2EFDA;strokeColor=#548235;" vertex="1" parent="1"><mxGeometry x="56" y="700" width="40" height="16" as="geometry"/></mxCell><mxCell id="c699" value="Mesa de servicio" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="696" width="240" height="24" as="geometry"/></mxCell><mxCell id="c700" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#FBE5D6;strokeColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="56" y="726" width="40" height="16" as="geometry"/></mxCell><mxCell id="c701" value="Operación e incidentes" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="722" width="240" height="24" as="geometry"/></mxCell><mxCell id="c702" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#E8E3F3;strokeColor=#6B4FA0;" vertex="1" parent="1"><mxGeometry x="56" y="752" width="40" height="16" as="geometry"/></mxCell><mxCell id="c703" value="Puerta de seguridad" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="748" width="240" height="24" as="geometry"/></mxCell><mxCell id="c704" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="56" y="778" width="40" height="16" as="geometry"/></mxCell><mxCell id="c705" value="Usuarios y auditoría" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="774" width="240" height="24" as="geometry"/></mxCell><mxCell id="c706" value="" style="fontFamily=Helvetica;rounded=0;fillColor=#E7E6E6;strokeColor=#595959;" vertex="1" parent="1"><mxGeometry x="56" y="804" width="40" height="16" as="geometry"/></mxCell><mxCell id="c707" value="Asistente de IA" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="106" y="800" width="240" height="24" as="geometry"/></mxCell><mxCell id="c708" value="&lt;b style=&quot;font-size:12px&quot;&gt;Índices únicos y parciales&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;incidents&lt;/b&gt;: ux_incidents_fingerprint_abierto (fingerprint) WHERE status = &#x27;abierto&#x27; → una alerta no abre dos incidentes.&lt;br&gt;• &lt;b&gt;change_requests&lt;/b&gt;: uq_change_requests_open_per_service (service_id) WHERE status IN (&#x27;pendiente&#x27;,&#x27;aprobada&#x27;,&#x27;en_validacion&#x27;) → un cambio abierto por servicio.&lt;br&gt;• &lt;b&gt;users&lt;/b&gt;: uq_users_email_lower (lower(email)).&lt;br&gt;• &lt;b&gt;security_checks&lt;/b&gt;: (run_id, step, coalesce(image,&#x27;&#x27;)).&lt;br&gt;• &lt;b&gt;kb_chunks&lt;/b&gt;: (document_id, position); ON DELETE CASCADE.&lt;br&gt;• &lt;b&gt;services&lt;/b&gt;: host y namespace únicos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sin FK:&lt;/b&gt; sla_policies se usa por valor de priority (P1–P4) en tickets e incidents; audit_logs.entity / entity_id apunta a cualquier tabla." style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9CED6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=10.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="320" height="400" as="geometry"/></mxCell><mxCell id="c709" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1808" width="2480" height="2" as="geometry"/></mxCell><mxCell id="c710" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia por introspección de backend/app/models/ con SQLAlchemy 2.1.1 compilado para PostgreSQL (tipos, nulabilidad, claves e índices); las migraciones (backend/alembic/versions/, 17 archivos) no añaden restricciones CHECK. Fechas en UTC (timestamptz). Se omite alembic_version.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1814" width="2480" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="Casos de uso · CU-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA CU-1 · CASOS DE USO (VISTA 1 DE 2)&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Casos de uso de CloudOps Hub: actores humanos&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;UML 2.5 · sujeto, actores primarios, generalización de actores, «include» y «extend» con puntos de extensión&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#B