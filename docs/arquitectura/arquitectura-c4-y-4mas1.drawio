l=1;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#262626;labelBackgroundColor=#FFFFFF;rounded=0;endSize=10;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="«extend»" style="fontFamily=Helvetica;endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#262626;labelBackgroundColor=#FFFFFF;rounded=0;endSize=10;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="«include»" style="fontFamily=Helvetica;endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#262626;labelBackgroundColor=#FFFFFF;rounded=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="623"/><mxPoint x="790" y="713"/></Array></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Generalización omitida.&lt;/b&gt; Administrador y Técnico comparten el rol &lt;i&gt;agencia&lt;/i&gt; y pueden ejecutar los casos del otro; se separan para mostrar la responsabilidad habitual." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="1160" y="970" width="330" height="90" as="geometry"/></mxCell><mxCell id="c45" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1288" width="1820" height="2" as="geometry"/></mxCell><mxCell id="c46" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de entrega/00-informe/15-casos-de-uso.md y de los controles de acceso del código (require_agency, current_user con alcance por cliente y tokens de máquina en backend/app/routers/). «extend»: comportamiento opcional dentro del caso base; «include»: paso obligatorio.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1294" width="1820" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="Modelo entidad-relación"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA ER-1 · MODELO DE DATOS&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Diagrama entidad-relación de la base de datos del Hub&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;PostgreSQL 16 · 22 tablas y 32 claves foráneas · notación de pata de gallo (Information Engineering) · modelo físico completo&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="2480" height="2" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:13px&quot;&gt;agencies&lt;/b&gt;" style="fontFamily=Helvetica;swimlane;html=1;startSize=34;fillColor=#DCE6F2;strokeColor=#2F5597;swimlaneFillColor=#FFFFFF;fontColor=#1F2937;collapsible=0;container=1;rounded=0;fontSize=12;swimlaneLine=1;" vertex="1" parent=