# Imagen del backend del formulario de citas de Dental Popayán (copia de la plantilla landing-form): multi-stage y sin root.
# Construir desde esta carpeta: docker build -f Dockerfile.backend --build-arg APP_VERSION=v1 -t hub/consultorio-api:v1 .

# ---------- Etapa 1: instalar dependencias ----------
FROM python:3.12-slim AS build
WORKDIR /build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---------- Etapa 2: imagen final (usuario app, UID 10001) ----------
FROM python:3.12-slim
ARG APP_VERSION=v1
ENV APP_VERSION=${APP_VERSION} \
    CONTACT_DB_PATH=/tmp/contact.db \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /install /usr/local
WORKDIR /app
COPY backend/app ./app
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
