iva del asistente" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="440" y="1652" width="280" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-20&lt;/b&gt; Reindexar la base de conocimiento" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="440" y="1726" width="280" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-21&lt;/b&gt; Consultar la bitácora de auditoría" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="440" y="1800" width="280" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-09.1&lt;/b&gt; Registrar horas trabajadas" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#6E86A8;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="800" y="862" width="280" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-22&lt;/b&gt; Verificar la puerta de seguridad" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#6E86A8;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="800" y="1026" width="280" height="60" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-23&lt;/b&gt; Publicar la versión en hub-gitop