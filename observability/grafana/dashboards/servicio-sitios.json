    {
      "id": 5,
      "type": "stat",
      "title": "Presupuesto de error restante · La Sazón",
      "description": "100 % = sin errores; 0 % = justo en el SLO (99.9 %); negativo = SLO incumplido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - (1 - avg_over_time(probe_success{job=\"sitios\",client=\"restaurante\"}[$__range])) / 0.001)",
          "instant": true,
          "legendFormat": "{{client}}"
        }
      ],
      "fieldConfig": {
