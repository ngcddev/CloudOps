# Imagen del frontend de Colegio San Marcos (copia de la plantilla landing-form): Nginx sin root (UID 101) en el puerto 8080.
# Construir desde esta carpeta: docker build -f Dockerfile.frontend --build-arg APP_VERSION=v1 -t hub/colegio-web:v1 .
# Al arrancar, la imagen reemplaza ${APP_VERSION} y ${API_UPSTREAM} en la plantilla de nginx.conf.

FROM nginxinc/nginx-unprivileged:1.30-alpine
# Parche de seguridad: la imagen base trae paquetes de Alpine con vulnerabilidades que ya tienen arreglo (brotli-libs crítica; curl, expat, libxslt, musl y zlib altas).
# La puerta de seguridad (Trivy) bloquea la imagen mientras haya críticas corregibles; se actualizan todos los paquetes (spec 018, T02).
USER root
RUN apk upgrade --no-cache
ARG APP_VERSION=v1
# API_UPSTREAM = host:puerto del backend; en docker compose se cambia por el servicio del cliente.
ENV APP_VERSION=${APP_VERSION} \
    API_UPSTREAM=backend:8000
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template
COPY frontend/index.html frontend/styles.css frontend/app.js /usr/share/nginx/html/
USER 101
EXPOSE 8080
