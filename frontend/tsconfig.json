// Configuración de TypeScript del frontend (código de la app y archivos de configuración de Vite).
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    // Alias de la carpeta seed/ del repo (igual que en vite.config.ts)
    "paths": { "@seed/*": ["../seed/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
