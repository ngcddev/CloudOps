#!/usr/bin/env bash
# Arranque de la VM del Hub: instala k3s y deja el nodo listo (spec 024, T05). Argo CD trae el resto.
set -euo pipefail

if [ ! -f /etc/rancher/k3s/k3s.yaml ]; then
  # La IP pública entra al certificado de la API para poder usar kubectl desde el equipo.
  curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server \
    --tls-san ${ip_publica} \
    --write-kubeconfig-mode 600
fi

until kubectl get nodes 2>/dev/null | grep -q " Ready"; do sleep 5; done
echo "k3s listo" > /var/log/hub-arranque.ok
