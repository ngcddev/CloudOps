ue="«extend»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="«extend»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="«extend»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="«include»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="«include»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="«include»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="«include»" style="fontFamily=Helvetica;endArrow=open;endFill=0;endSize=11;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;fontSize=10;fontColor=#1F3B5C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="&lt;b&gt;Reglas que el diagrama no puede mostrar&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Todo caso exige sesión (CU-01); el cliente solo ve lo de su empresa.&lt;br&gt;• CU-12 lo aprueba una persona distinta de quien pidió el cambio, y solo si la versión pasó la puerta (CU-22).&lt;br&gt;• CU-14.1 se ofrece cuando el incidente sigue a un cambio; CU-14.2 deja el texto como &lt;i&gt;borrador_ia&lt;/i&gt; hasta que una persona lo aprueba.&lt;br&gt;• CU-23 escribe en Git; el Hub no habla con Kubernetes.&lt;br&gt;&lt;br&gt;Las automatizaciones y los sistemas externos que participan están en la &lt;b&gt;Figura CU-2&lt;/b&gt;." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="310" height="220" as="geometry"/></mxCell><mxCell id="c71" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1958" width="1820" height="2" as="geometry"/></mxCell><mxCell id="c72" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de backend/app/routers/ (require_agency, current_user con alcance por cliente) y frontend/src/App.tsx (rutas por rol). Óvalo claro: caso incluido o de extensión. «include»: paso obligatorio del caso base; «extend»: comportamiento opcional en el punto de extensión indicado; triángulo hueco: generalización de actores.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1964" width="1820" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="Casos de uso · CU-2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA CU-2 · CASOS DE USO (VISTA 2 DE 2)&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;Casos de uso de CloudOps Hub: automatizaciones y sistemas externos&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;UML 2.5 · actores primarios de sistema y de tiempo (izquierda) y actores de apoyo (derecha) que participan en cada caso&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1820" height="2" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:14px&quot;&gt;CloudOps Hub&lt;/b&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFDFE;strokeColor=#1F3B5C;strokeWidth=1.6;align=center;verticalAlign=top;spacingTop=8;fontColor=#1F3B5C;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="860" height="1090" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-16&lt;/b&gt; Consultar los tableros de la agencia" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="190" width="280" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-14.2&lt;/b&gt; Generar borradores y diagnóstico con IA" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#6E86A8;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="290" width="280" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-18&lt;/b&gt; Preguntar al asistente" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="390" width="280" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-20&lt;/b&gt; Reindexar la base de conocimiento" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="490" width="280" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-23&lt;/b&gt; Publicar la versión en hub-gitops" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#6E86A8;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="610" width="280" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-26&lt;/b&gt; Confirmar publicación o rollback" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="730" width="280" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-24&lt;/b&gt; Registrar caída o recuperación de un sitio" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="860" width="280" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;color:#1F3B5C&quot;&gt;CU-25&lt;/b&gt; Registrar una corrida de la puerta de seguridad" style="fontFamily=Helvetica;ellipse;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=11;fontColor=#1F2937;spacing=12;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry x="810" y="990" width="280" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Personal de la agencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;rol agencia&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="36" height="66" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Reloj&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«tiempo» · cada 15 s&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="250" y="726" width="36" height="66" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · token de máquina&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="250" y="856" width="36" height="66" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Pipeline de seguridad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · Gitea Actions&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="250" y="986" width="36" height="66" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · métricas&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="180" width="36" height="66" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Loki&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · registros&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="300" width="36" height="66" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · LLM local&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="420" width="36" height="66" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Gitea&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema» · repo hub-gitops&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="600" width="36" height="66" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#4B5563&quot;&gt;«sistema»&lt;/span&gt;" style="fontFamily=Helvetica;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#1F2937;fillColor=#FFFFFF;strokeWidth=1.4;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="760" width="36" height="66" as="geometry"/></mxCell><mxCell id="e21" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c4" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c5" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c5" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c6" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c8" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="" style="fontFamily=Helvetica;endArrow=none;html=1;rounded=0;strokeColor=#404040;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c9" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;Cómo leer esta vista&lt;/b&gt;&lt;br&gt;&lt;br&gt;• CU-14.2 y CU-23 no tienen actor primario aquí: se alcanzan desde CU-12, CU-13 y CU-14 (Figura CU-1).&lt;br&gt;• CU-24 abre el incidente P1 sin duplicar (huella) con «firing» y lo mitiga con «resolved».&lt;br&gt;• CU-25 registra cada control de la puerta: Gitleaks, pruebas, Trivy, Syft y Cosign.&lt;br&gt;• CU-26 lo dispara el vigilante de despliegues cada 15 s; consulta Argo CD y alinea la versión con Gitea." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#B8A14A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10.5;fontColor=#3F3F3F;" vertex="1" parent="1"><mxGeometry x="1440" y="900" width="420" height="170" as="geometry"/></mxCell><mxCell id="c37" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1248" width="1820" height="2" as="geometry"/></mxCell><mxCell id="c38" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir de backend/app/routers/alerts.py y pipeline.py (tokens de máquina), services/deploy_watch.py (INTERVAL_SECONDS = 15) e integrations/ (prometheus, loki, ollama, gitea, argocd). «sistema» y «tiempo» son estereotipos de actor; las líneas son asociaciones.&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1254" width="1820" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="Pipeline · CI GitHub"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="990" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;font-size:11px;color:#1061B0;font-weight:bold;letter-spacing:1px&quot;&gt;FIGURA · INTEGRACIÓN CONTINUA&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;color:#1F2937;margin-top:2px&quot;&gt;CI del repositorio (GitHub Actions)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4B5563;margin-top:4px&quot;&gt;Diagrama de actividad UML · .github/workflows/ci.yml corre cinco trabajos en paralelo; el cambio solo se fusiona si los cinco pasan&lt;/div&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#BFC5CD;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="1400" height="2" as="geometry"/></mxCell><mxCell id="c3" value="" style="fontFamily=Helvetica;ellipse;html=1;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="727" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Recibir el cambio&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:9.5px;color:#4B5563&#x27;&gt;push a main o dev, etiqueta v* o pull request&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="188" width="300" height="52" as="geometry"/></mxCell><mxCell id="c5" value="" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="1240" height="8" as="geometry"/></mxCell><mxCell id="e6" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;div style=&#x27;font-size:9.5px;color:#5B7AA5;font-family:monospace&#x27;&gt;calidad&lt;/div&gt;&lt;b&gt;Lint y compilación del frontend&lt;/b&gt;&lt;div style=&#x27;font-size:10px;margin-top:4px;line-height:1.25&#x27;&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• ruff con ruff.toml&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• tsc (tipos) y vite build&lt;/div&gt;&lt;/div&gt;&lt;div style=&#x27;font-size:10px;margin-top:8px;color:#9C3D0A&#x27;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; un aviso de ruff o un error de tipos&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="120" y="318" width="232" height="236" as="geometry"/></mxCell><mxCell id="e9" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.0935483870967742;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;div style=&#x27;font-size:9.5px;color:#5B7AA5;font-family:monospace&#x27;&gt;pruebas&lt;/div&gt;&lt;b&gt;Backend y ai/&lt;/b&gt;&lt;div style=&#x27;font-size:10px;margin-top:4px;line-height:1.25&#x27;&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• pytest del backend (1.133 pruebas)&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• registro en MLflow y evaluación de ai/&lt;/div&gt;&lt;/div&gt;&lt;div style=&#x27;font-size:10px;margin-top:8px;color:#9C3D0A&#x27;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; una prueba falla&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="370" y="318" width="232" height="236" as="geometry"/></mxCell><mxCell id="e11" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.29516129032258065;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;div style=&#x27;font-size:9.5px;color:#5B7AA5;font-family:monospace&#x27;&gt;operacion&lt;/div&gt;&lt;b&gt;Observabilidad y respaldo&lt;/b&gt;&lt;div style=&#x27;font-size:10px;margin-top:4px;line-height:1.25&#x27;&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• promtool, amtool y kustomize&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• Grafana carga el tablero&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• trazas del Hub hasta Tempo&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• el chart de Helm coincide con Kustomize&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• respaldo y restauración de PostgreSQL&lt;/div&gt;&lt;/div&gt;&lt;div style=&#x27;font-size:10px;margin-top:8px;color:#9C3D0A&#x27;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; una regla, el tablero, las trazas o el respaldo fallan&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="620" y="318" width="232" height="236" as="geometry"/></mxCell><mxCell id="e13" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.4967741935483871;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&#x27;font-size:9.5px;color:#5B7AA5;font-family:monospace&#x27;&gt;analisis&lt;/div&gt;&lt;b&gt;Estático y de composición&lt;/b&gt;&lt;div style=&#x27;font-size:10px;margin-top:4px;line-height:1.25&#x27;&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• bandit (SAST)&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• trivy fs (dependencias)&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• imagen del frontend&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• registro de hallazgos con VEX (artefacto)&lt;/div&gt;&lt;/div&gt;&lt;div style=&#x27;font-size:10px;margin-top:8px;color:#9C3D0A&#x27;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; un hallazgo ALTO o CRÍTICO sin decisión vigente&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="870" y="318" width="232" height="236" as="geometry"/></mxCell><mxCell id="e15" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.6983870967741935;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&#x27;font-size:9.5px;color:#5B7AA5;font-family:monospace&#x27;&gt;seguridad&lt;/div&gt;&lt;b&gt;Imagen de producción del Hub&lt;/b&gt;&lt;div style=&#x27;font-size:10px;margin-top:4px;line-height:1.25&#x27;&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• Gitleaks en toda la historia&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• construye sin root, sin pytest y responde /health&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• Trivy: CRÍTICA con arreglo&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• Trivy config: Dockerfile y manifiestos&lt;/div&gt;&lt;div style=&#x27;margin-top:3px&#x27;&gt;• Syft SPDX y licencias (artefacto)&lt;/div&gt;&lt;/div&gt;&lt;div style=&#x27;font-size:10px;margin-top:8px;color:#9C3D0A&#x27;&gt;&lt;b&gt;Bloquea si:&lt;/b&gt; un secreto, una CVE crítica, configuración insegura o una licencia crítica&lt;/div&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2F5597;strokeWidth=1.3;fontSize=10.5;fontColor=#1F2937;spacing=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1120" y="318" width="232" height="236" as="geometry"/></mxCell><mxCell id="e17" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#262626;strokeWidth=1.2;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="fontFamily=Helvetica;rounded=0;html=1;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="12