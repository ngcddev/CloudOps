# Variables de entorno de desarrollo del Hub.
# Copiar a .env (ignorado por Git) antes de levantar el entorno:  cp .env.example .env
# Solo valores de desarrollo local; nunca poner aquí contraseñas reales (RNF-06).

# ---------- PostgreSQL (servicio db) ----------
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_dev
POSTGRES_DB=hub
# Puerto en tu máquina; cámbialo si ya usas el 5432
DB_PORT=5432

# ---------- API (servicio api) ----------
# Dentro de docker compose el host de la base es "db"
DATABASE_URL=postgresql+psycopg://hub:hub_dev@db:5432/hub
# Puerto de la API en tu máquina
API_PORT=8000

# ---------- Frontend (servicio web) ----------
# Puerto de la consola en tu máquina
WEB_PORT=5173

# ---------- Sitios de los clientes (spec 002) ----------
# Versión de cada sitio (v1 = sana, v2 = rota a propósito: HTTP 500 en / y /health) y su puerto
RESTAURANTE_VERSION=v1
RESTAURANTE_PORT=8081
FERRETERIA_VERSION=v1
FERRETERIA_PORT=8082
