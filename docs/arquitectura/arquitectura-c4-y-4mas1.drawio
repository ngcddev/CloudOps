ometry></mxCell><mxCell id="e37" value="&lt;b style=&quot;color:#374151&quot;&gt;Despliega y reconcilia cada sitio en su namespace&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280&quot;&gt;[API de Kubernetes]&lt;/span&gt;" style="fontFamily=Helvetica;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=10;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="1100"/><mxPoint x="1600" y="1100"/></Array></mxGeometry></mxCell><mxCell id="c38" value="" style="fontFamily=Helvetica;line;strokeWidth=1;strokeColor=#D9DDE2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1208" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c39" value="&lt;span style=&quot;font-size:10px;color:#4B5563&quot;&gt;&lt;i&gt;Nota.&lt;/i&gt; Elaboración propia a partir del código. Fuentes: backend/app/integrations/ (gitea, argocd, prometheus, loki, ollama), backend/app/routers/alerts.py y pipeline.py, gitops/hub/api.yaml y networkpolicy.yaml, observability/alertmanager/alertmanager.yml. El Hub no habla con Kubernetes: solo con Gitea, Argo CD y la telemetría (constitución, principio de entrega por GitOps).&lt;/span&gt;" style="fontFamily=Helvetica;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="1720" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="C4 · N2 Contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1480" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id