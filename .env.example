# Variables de entorno de desarrollo del Hub.
# Copiar a .env (ignorado por Git) antes de levantar el entorno:  cp .env.example .env
# Solo valores de desarrollo local; nunca poner aquí contraseñas reales (RNF-06).

# ---------- PostgreSQL (servicio db) ----------
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_dev
POSTGRES_DB=hub
# Puerto en tu máquina; cámbialo si ya usas el 5432
DB_PORT=5432

# ---------- API (servicio api) ----------
# Dentro de docker compose el host de la base es "db"
DATABASE_URL=postgresql+psycopg://hub:hub_dev@db:5432/hub
# Puerto de la API en tu máquina
API_PORT=8000

# ---------- Sesiones (spec 007) ----------
# Clave con la que la API firma los tokens de sesión. Solo desarrollo: en k3s va en el Secret hub-auth.
JWT_SECRET=clave-de-desarrollo-cambiala-en-produccion-0123456789
# Contraseña que el seed aplica a todos los usuarios sembrados (solo desarrollo local)
SEED_USER_PASSWORD=hub-desarrollo

# ---------- Frontend (servicio web) ----------
# Puerto de la consola en tu máquina
WEB_PORT=5173

# ---------- Sitios de los clientes (spec 002) ----------
# Versión de cada sitio (v1 = sana, v2 = rota a propósito: HTTP 500 en / y /health) y su puerto
RESTAURANTE_VERSION=v1
RESTAURANTE_PORT=8081
FERRETERIA_VERSION=v1
FERRETERIA_PORT=8082
CONSULTORIO_VERSION=v1
CONSULTORIO_PORT=8083

# ---------- GitOps (spec 005) ----------
# Gitea y Argo CD tal como los ve la API. Van comentadas a propósito: con ellas definidas la API arranca el
# seguimiento de Argo CD y, sin un clúster, falla cada 15 s. Descoméntalas solo si el compose debe hablar con
# un Gitea y un Argo CD reales. Los tokens de aquí son valores de ejemplo, no reales: los verdaderos los
# crea gitops/hub/crear-tokens.sh y viven solo en el Secret hub-gitops-tokens.
GITEA_REPO=forja-digital/hub-gitops
#GITEA_URL=http://gitea.hub.local
#GITEA_TOKEN=token-de-ejemplo-gitea
#ARGOCD_URL=http://argocd.hub.local
#ARGOCD_TOKEN=token-de-ejemplo-argocd
