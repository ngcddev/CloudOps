// Configuración de Grafana Alloy (spec 008, T25 y spec 022, T26): lee por la API de Kubernetes los registros de los Pods
// de los clientes (namespaces cliente-*) y del Hub (namespace hub, sin PostgreSQL ni el respaldo) de su nodo y los manda a Loki con las etiquetas namespace, pod y container.
// Reemplaza a Promtail, que está en fin de vida. No necesita montar carpetas del nodo.

discovery.kubernetes "pods" {
  role = "pod"
  // DaemonSet: cada Alloy descubre solo los Pods de su propio nodo (NODE_NAME viene del Pod); sin esto todos recogerían todo y los registros saldrían duplicados
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

discovery.relabel "clientes" {
  targets = discovery.kubernetes.pods.targets

  // Los sitios de los clientes y el Hub (API, web, voz y Backstage); el resto de la plataforma no se recoge (ahorra memoria y disco). Un 500 del Hub
  // se sigue en Loki con su id de petición y su trace_id (auditoría OB-04). Loki guarda 72 h.
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "cliente-.+|hub"
    action        = "keep"
  }
  // PostgreSQL y el respaldo registran consultas y nombres de archivos con datos de las personas: no se recogen
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "postgres|hub-db-backup"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  // El cliente sale del namespace, igual que en Prometheus: cliente-restaurante → restaurante
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "cliente-(.+)"
    target_label  = "client"
  }
}

loki.source.kubernetes "clientes" {
  targets    = discovery.relabel.clientes.output
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
  }
}
